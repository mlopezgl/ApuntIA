rules_version = '2';

// ApuntIA: cada usuario solo puede leer y escribir su propio documento de estudio.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'schema'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.schema is int;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
